{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch UI Pro (debug)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/etoolscode/main.go",
            "args": [
                "--ui"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "DSAC_UI_AUTH": "off",
                "DSAC_UI_PRO": "1",
                "HTTP_PORT": "8080"
            }
        }
    ]
}