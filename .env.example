# etoolscode — exemplo de ambiente
# Copie para .env e preencha (não commite segredos)

# LLM
LLM_CLIENT=1
DEEPSEEK_API_KEY=
META_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# UI
HTTP_PORT=8080
# Hash da senha da UI (gere com: go run ./cmd/hashpw)
DSAC_UI_PASSWORD_HASH=
# DSAC_UI_PASSWORD=   # só se o código ainda aceitar plain (evitar em prod)

# Issues
ISSUES_DIR=/home/opc/prj/issues
DS_AC_BASE=/home/opc/prj/issues/base.json

# Git automático ao rodar issue (default true)
DSAC_GIT_AUTO_BRANCH=true

# UI Pro como default em "/" (opcional)
# DSAC_UI_PRO=true
